# 复制本文件为 .env，再填入你自己的密钥。.env 已被 .gitignore 忽略，不会进入 Git。

# ───────── 大模型（必填） ─────────
LLM_API_KEY=sk-在这里填入你的密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# deepseek-flash 默认开启思考模式，思考 token 按输出计费。
# disabled = 关闭（便宜、快）；enabled = 开启；留空 = 不发送该参数（换用其他厂商模型时用）。
LLM_THINKING=disabled

# ───────── 文献检索源（可选） ─────────
# 用逗号分隔，可选：arxiv、openalex、semantic_scholar。默认同时使用 arxiv 和 openalex。
# arXiv 几乎不收录医学、营养学等方向的论文，这类题目只用 openalex 即可，省下排队检索的时间。
SEARCH_SOURCES=arxiv,openalex

# OpenAlex 不填密钥也能用，但每天的免费额度较小（大约够跑几次）。
# 在 https://openalex.org/settings/api 免费注册一个密钥后，额度是原来的 10 倍。
OPENALEX_API_KEY=

# Semantic Scholar 不带密钥时容易被限流，建议有密钥再把 semantic_scholar 加进 SEARCH_SOURCES。
SEMANTIC_SCHOLAR_API_KEY=

# ───────── 工作流的预算上限（可选，以下为默认值） ─────────
MAX_SUB_QUESTIONS=4
MAX_QUERIES_PER_SUB_QUESTION=3
PAPERS_PER_QUERY=6
MAX_CANDIDATES_PER_SUB_QUESTION=15
MAX_FINDINGS_PER_SUB_QUESTION=8
MAX_RESEARCH_ROUNDS=2
MAX_REVISIONS=1
